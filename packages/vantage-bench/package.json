{
  "name": "@jourdanlabs/vantage-bench",
  "version": "1.0.0",
  "description": "VANTAGE Benchmark Harness — run any static analysis tool against standardized corpora",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vantage-bench": "./bin/vantage-bench.js"
  },
  "scripts": {
    "run": "node bin/vantage-bench.js run",
